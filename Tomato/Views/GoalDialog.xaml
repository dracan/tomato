<Window x:Class="Tomato.Views.GoalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Tomato.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:GoalDialogViewModel}"
        Title="New Focus Session"
        Width="350"
        Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Border CornerRadius="8"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource SurfaceBrush}"
            BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Prompt -->
            <TextBlock Grid.Row="0"
                       Text="What do you want to focus on?"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <!-- Goal TextBox -->
            <TextBox Grid.Row="1"
                     Text="{Binding Goal, UpdateSourceTrigger=PropertyChanged}"
                     Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource TextSecondaryBrush}"
                     BorderThickness="1"
                     Padding="8"
                     FontSize="14"
                     AcceptsReturn="False"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     x:Name="GoalTextBox"/>

            <!-- Estimate -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,12,0,0">
                <TextBlock Text="Estimate"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox Text="{Binding Estimate, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource TextSecondaryBrush}"
                         BorderThickness="1"
                         Padding="6,4"
                         FontSize="14"
                         Width="56"
                         MaxLength="3"
                         HorizontalContentAlignment="Right"
                         x:Name="EstimateTextBox"/>
                <TextBlock Text="minutes (1-120)"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"
                        Padding="16,8"
                        Margin="0,0,8,0"/>
                <Button Content="Start"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ConfirmCommand}"
                        Padding="16,8"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
